{
  "venvPath": "./backend",
  "venv": ".venv",
  "include": ["backend/app", "backend/tests", "scripts"],
  "exclude": ["backend/.venv", "frontend/node_modules"],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "backend",
        "backend/.venv/lib/python3.11/site-packages",
        "backend/.venv/lib/python3.12/site-packages"
      ]
    },
    {
      "root": "scripts",
      "extraPaths": ["backend"]
    }
  ]
}
