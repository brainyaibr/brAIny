# ---------------------------------------------------------------------------
# brAIny — variáveis de ambiente
# Copie para `.env` (na raiz do projeto) e preencha.
# NUNCA coloque chaves no frontend: só o backend lê este arquivo.
# ---------------------------------------------------------------------------

# --- LLM (obrigatório) ------------------------------------------------------
# Qualquer endpoint compatível com OpenAI Chat Completions.
# Exemplos:
#   OpenAI          https://api.openai.com/v1
#   Groq            https://api.groq.com/openai/v1
#   OpenRouter      https://openrouter.ai/api/v1
#   Ollama (local)  http://localhost:11434/v1
BRAINY_LLM_BASE_URL=https://api.openai.com/v1
# Preencha com uma chave real do provedor escolhido; o exemplo vazio não ativa o LLM.
BRAINY_LLM_API_KEY=

# Modelo padrão e allowlist aplicada pelo backend. Use somente IDs realmente
# disponíveis no endpoint configurado. Em produção, o modelo padrão deve estar na allowlist.
BRAINY_LLM_MODEL=gpt-5-mini
BRAINY_ALLOWED_MODELS=gpt-5-mini
# Preencha preços reais, conferidos no provedor/contrato. Não use valores estimados ou exemplos.
# Formato: {"model-id":{"input_per_1k_usd":N,"output_per_1k_usd":N}}
BRAINY_MODEL_PRICES_JSON={}
# Teto global mensal aprovado pelo responsável, em USD. Sem valor, produção não inicia.
BRAINY_GLOBAL_MONTHLY_BUDGET_USD=
# Overrides opcionais de limites por plano e por usuário, sempre por mês UTC.
# Somente acrescente limites que deseja substituir; os demais usam os padrões do código.
# IDs de usuários devem ser os IDs internos autenticados, nunca e-mails ou tokens.
BRAINY_PLAN_USAGE_QUOTAS_JSON={}
BRAINY_USER_USAGE_QUOTAS_JSON={}

# Esforço de raciocínio para modelos GPT-5 (minimal | low | medium | high)
BRAINY_LLM_EFFORT=low

# Limite de tokens de saída e timeout (segundos) por chamada
BRAINY_LLM_MAX_TOKENS=12000
BRAINY_LLM_TIMEOUT=240
BRAINY_LLM_RETRIES=2

# --- Imagens e vetorização (opcional) ---------------------------------------
# svg    = fallback por código, o LLM escreve o SVG (sem raster)
# openai = GPT Image 2/2.5 -> PNG/Base64 -> vtracer -> SVG real
# google = Nano Banana 2.1/Pro -> output_image.data -> vtracer -> SVG real
BRAINY_IMAGE_PROVIDER=svg
BRAINY_IMAGE_BASE_URL=https://api.openai.com/v1
BRAINY_IMAGE_API_KEY=
BRAINY_IMAGE_MODEL=gpt-image-2.5-flare
BRAINY_IMAGE_SIZE=1024x1024
BRAINY_IMAGE_QUALITY=medium
BRAINY_IMAGE_OUTPUT_FORMAT=png

# Google Gemini Interactions API (use GEMINI_API_KEY como alternativa)
BRAINY_GOOGLE_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/interactions
BRAINY_GOOGLE_IMAGE_API_KEY=
BRAINY_GOOGLE_IMAGE_MODEL=gemini-nano-banana-2.1
# Preço por imagem real, específico do modelo/provedor; em produção é exigido
# quando BRAINY_IMAGE_PROVIDER usa um provedor raster externo.
# Formato: {"model-id":{"per_image_usd":N}}
BRAINY_IMAGE_PRICES_JSON={}

# Saída raster de provedores externos nunca é entregue diretamente ao usuário.
BRAINY_VECTORIZE_RASTER=true
BRAINY_VECTORIZER_COLOR_MODE=color
BRAINY_VECTORIZER_HIERARCHICAL=stacked
BRAINY_VECTORIZER_MODE=spline
BRAINY_VECTORIZER_FILTER_SPECKLE=4
BRAINY_VECTORIZER_COLOR_PRECISION=6
BRAINY_VECTORIZER_LAYER_DIFFERENCE=16
BRAINY_VECTORIZER_CORNER_THRESHOLD=60
BRAINY_VECTORIZER_LENGTH_THRESHOLD=4
BRAINY_VECTORIZER_MAX_ITERATIONS=10
BRAINY_VECTORIZER_SPLICE_THRESHOLD=45
BRAINY_VECTORIZER_PATH_PRECISION=3

# --- Sandbox / autocorreção -------------------------------------------------
# Quantas vezes o brAIny tenta se corrigir sozinho antes de mostrar o resultado
BRAINY_MAX_REPAIR_ATTEMPTS=3
# Tentativas máximas do job incluindo a inicial, antes de exigir intervenção.
BRAINY_MAX_JOB_ATTEMPTS=3
# Deadline total do worker por job; trabalhos em execução são cancelados ao vencer.
BRAINY_JOB_TIMEOUT_SECONDS=900
# Duração máxima de uma conexão SSE de progresso; o cliente pode reconectar.
BRAINY_JOB_STREAM_TIMEOUT=600

# --- Servidor ---------------------------------------------------------------
# Local/testes: development ou test. A imagem Docker define production.
BRAINY_ENV=development
# Em produção: HTTPS explícito, separado por vírgula para múltiplas origens.
# Nunca use * em produção.
BRAINY_CORS_ORIGINS=
# Origem HTTPS canônica para callbacks OAuth publicados; configure explicitamente.
BRAINY_PUBLIC_ORIGIN=
# Rate limiting, idempotência e coordenação de jobs usam o banco local neste modo.
# Em produção, o banco MySQL gerenciado é fornecido pelo runtime via DATABASE_URL.
# Retenção de resultados concluídos de operações com Idempotency-Key (segundos).
BRAINY_IDEMPOTENCY_TTL=86400
# Plano estrutural inicial; não habilita cobrança ou pagamento.
BRAINY_DEFAULT_PLAN=FREE
# Segredo próprio para assinar sessões quando a chave JWT do runtime não for adequada.
# Use um valor aleatório com pelo menos 32 caracteres; se ausente, a aplicação deriva uma chave separada
# do BRAINY_CSRF_SECRET somente quando ele também for forte.
BRAINY_SESSION_SECRET=
# Segredo dedicado para assinar tokens CSRF; em produção, use um valor aleatório forte.
BRAINY_CSRF_SECRET=
# Duração do token CSRF em segundos (padrão: 30 dias)
BRAINY_CSRF_TOKEN_TTL=2592000
BRAINY_HOST=0.0.0.0
BRAINY_PORT=8080
BRAINY_DATA_DIR=./data
BRAINY_DB_PATH=./data/brainy.db

# Em produção é obrigatório um banco MySQL/MariaDB gerenciado com TLS.
# DATABASE_URL=mysql://usuario:senha@host:3306/brainy?ssl=true
